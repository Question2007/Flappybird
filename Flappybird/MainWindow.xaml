<Window x:Class="Flappybird.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Flappybird"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>


        <Button x:Name="StartBtn" Content="Start" Width="100" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" Click="StartButton_Click" Grid.Row="0" Panel.ZIndex="1"/>
        <TextBlock x:Name="ScoreText" Text="Score: 0" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Grid.Row="0" Panel.ZIndex="1"/>

        <Canvas Name="GameCanvas" Background="LightBlue" Grid.Row="1">
            <Rectangle Name="Bird" Width="30" Height="30" Fill="Yellow" Canvas.Left="100" Canvas.Top="200"/>
            <Rectangle Name="PipeTop" Width="50" Height="250" Fill="Green" Canvas.Left="800" HorizontalAlignment="Center" VerticalAlignment="Top" Canvas.Top="-34"/>
            <Rectangle Name="PipeBottom" Width="50" Height="250" Fill="Green" Canvas.Left="800" Canvas.Top="355" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        </Canvas>
    </Grid>
</Window>
